// =============================================================================
// CarGlow — Prisma schema
// =============================================================================
// Postgres + Prisma. Designed for multi-tenant SaaS with workspaces.
// Run: pnpm db:generate && pnpm db:push
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  STAFF
  ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Plan {
  FREE
  ESSENTIAL
  PRO
  BUSINESS
  ENTERPRISE
}

enum VehicleStatus {
  DRAFT
  READY
  LISTED
  SOLD
  ARCHIVED
}

enum PhotoStatus {
  UPLOADED
  QUEUED
  PROCESSING
  ENHANCED
  FAILED
  EXPIRED
}

enum CreditReason {
  MONTHLY_GRANT
  PURCHASE
  ENHANCEMENT
  REFUND
  ADJUSTMENT
  MONTHLY_RESET
  PACK_PURCHASE
}

// ── AUTH (NextAuth.js) ───────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── CORE ─────────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  password          String?
  locale            String   @default("en")
  role              UserRole @default(USER)
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  workspaceMembers  WorkspaceMember[]
  photosCreated     Photo[]
  auditLogs         AuditLog[]
}

model Workspace {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  logoUrl             String?
  plan                Plan     @default(FREE)
  renewalDate         DateTime?
  monthlyCredits      Int      @default(2)
  bonusCredits        Int      @default(0)
  subscriptionStatus  String   @default("active")
  lastCreditReset     DateTime @default(now())
  /// @deprecated superseded by PricingConfig; kept until all reads are migrated, then dropped
  creditsPerMonth     Int?
  vatNumber           String?
  billingAddress      Json?
  billingEmail        String?
  stripeCustomerId    String?  @unique
  stripeSubscriptionId String? @unique
  ssoEnabled          Boolean  @default(false)
  ssoDomain           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members        WorkspaceMember[]
  invites        Invite[]
  vehicles       Vehicle[]
  photos         Photo[]
  folders        Folder[]
  tags           Tag[]
  styles         Style[]
  brandKits      BrandKit[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  auditLogs      AuditLog[]
  creditTxs      CreditTransaction[]

  @@index([stripeCustomerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(EDITOR)
  joinedAt    DateTime      @default(now())
  lastActiveAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(EDITOR)
  token       String        @unique
  expiresAt   DateTime
  invitedBy   String?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

// ── VEHICLES & MEDIA ─────────────────────────────────────────────────────────

model Vehicle {
  id            String        @id @default(cuid())
  workspaceId   String
  name          String
  vin           String?
  make          String?
  model         String?
  year          Int?
  mileage       Int?
  price         Decimal?      @db.Decimal(12,2)
  status        VehicleStatus @default(DRAFT)
  coverPhotoId  String?       @unique
  description   String?       @db.Text
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  coverPhoto Photo?    @relation("VehicleCover", fields: [coverPhotoId], references: [id])
  photos     Photo[]   @relation("VehiclePhotos")

  @@index([workspaceId])
  @@index([status])
}

model Folder {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  parentId    String?
  color       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]  @relation("FolderTree")
  photos    Photo[]

  @@index([workspaceId, parentId])
}

model Photo {
  id            String      @id @default(cuid())
  workspaceId   String
  vehicleId     String?
  folderId      String?
  sessionId     String?
  originalUrl   String
  enhancedUrl   String?
  thumbnailUrl  String?
  status        PhotoStatus @default(UPLOADED)
  styleUsed     String?
  toolsUsed     Json?       // array of {tool, params} pairs
  processingMs  Int?
  errorMessage  String?
  width         Int?
  height        Int?
  sizeBytes     Int?
  downloadedAt  DateTime?   // first download timestamp — undownloaded renders are purged 30 days after creation
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?   @relation("VehiclePhotos", fields: [vehicleId], references: [id], onDelete: SetNull)
  folder         Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy      User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  vehicleCoverOf Vehicle?   @relation("VehicleCover")
  tags           PhotoTag[]
  creditTxs      CreditTransaction[]
  shareLinks     ShareLink[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([vehicleId])
  @@index([sessionId])
  @@index([status])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#FF8A3D")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  photos    PhotoTag[]

  @@unique([workspaceId, name])
}

model PhotoTag {
  photoId String
  tagId   String
  photo   Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
}

// ── STYLES & BRAND ───────────────────────────────────────────────────────────

model Style {
  id           String   @id @default(cuid())
  name         String
  slug         String
  category     String   // Studio | Outdoor | Lifestyle | Premium | Custom
  thumbnailUrl String
  prompt       String?  @db.Text
  isCustom     Boolean  @default(false)
  workspaceId  String?  // nullable for global styles
  popularity   Int      @default(0)
  createdAt    DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([category])
}

model BrandKit {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String   @default("Default")
  logoUrl         String?
  plateFrameUrl   String?
  watermarkUrl    String?
  primaryColor    String   @default("#FF8A3D")
  secondaryColor  String?
  defaultStyleId  String?
  defaultPlateMask Boolean @default(true)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ── API / WEBHOOKS / AUDIT ──────────────────────────────────────────────────

model ApiKey {
  id          String   @id @default(cuid())
  workspaceId String
  label       String
  hashedKey   String   @unique
  prefix      String   // first 8 chars for display
  scopes      String[] // ["photos:read", "photos:write", ...]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Webhook {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  events      String[] // ["photo.enhanced", "vehicle.created", ...]
  secret      String
  isActive    Boolean  @default(true)
  failureCount Int     @default(0)
  lastFiredAt DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String   // photo.enhanced, member.invited, billing.updated, ...
  target      String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
}

// ── BILLING & SHARING ───────────────────────────────────────────────────────

model CreditTransaction {
  id              String       @id @default(cuid())
  workspaceId     String
  delta           Int          // positive for grant/purchase, negative for spend
  balanceAfter    Int
  reason          CreditReason
  featureKey      String?      // AiFeature.key this transaction relates to, e.g. "imageGeneration"
  bucket          String?      // "monthly" | "bonus" — which pool this delta was applied to
  photoId         String?
  stripeInvoiceId String?
  notes           String?
  createdAt       DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  photo     Photo?    @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
}

// Singleton row (id = "global") holding every tunable pricing number in the app.
// Edit this row (via the admin page or directly) to change pricing — no code changes needed.
model PricingConfig {
  id               String   @id @default("global")

  freeCredits      Int      @default(3) // FREE plan's monthly allotment, reset by /api/cron/reset-free-credits

  essentialPrice   Int      @default(39)
  essentialCredits Int      @default(100)

  proPrice         Int      @default(99)
  proCredits       Int      @default(300)

  businessPrice    Int      @default(199)
  businessCredits  Int      @default(700)

  pack1Price       Int      @default(19)
  pack1Credits     Int      @default(50)

  pack2Price       Int      @default(49)
  pack2Credits     Int      @default(150)

  pack3Price       Int      @default(99)
  pack3Credits     Int      @default(400)

  // Promotional pricing — a single active promo at a time, editable from the admin pricing
  // page instead of a hardcoded banner/date, so it can be started, changed or stopped without
  // a redeploy. Applies to the Essentiel plan only for now (promoPlan is still a real column,
  // not hardcoded, so a future promo can target a different plan without a migration).
  promoEnabled         Boolean   @default(false)
  promoLabel           String?   // e.g. "Offre d'été"
  promoPlan            String?   // which plan's displayed price is discounted, e.g. "ESSENTIAL"
                                  // (plain string, not the Plan enum — avoids a Prisma db push
                                  // ordering bug when adding an enum-typed column in the same
                                  // push as removing legacy enum variants; see commit notes)
  promoDiscountedPrice Int?      // e.g. 19 — shown as the new price for promoPlan
  promoCode            String?   // Stripe Promotion Code string, e.g. "ETE19"
  promoEndDate         DateTime? // promo stops showing/applying after this date

  updatedAt        DateTime @updatedAt
}

// One row per AI action / feature. Adding a new AI feature (Sky replacement, 360 panorama, ...)
// only requires inserting a new row here — no backend code changes.
model AiFeature {
  id         String   @id @default(cuid())
  key        String   @unique // stable identifier, e.g. "imageGeneration", "imageRetouch", "videoGeneration"
  label      String
  creditCost Int
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ShareLink {
  id        String   @id @default(cuid())
  slug      String   @unique
  photoId   String?
  vehicleId String?
  expiresAt DateTime?
  password  String?  // hashed if set
  viewCount Int      @default(0)
  createdBy String?
  createdAt DateTime @default(now())

  photo Photo? @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([slug])
}
